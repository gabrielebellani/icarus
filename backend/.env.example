# Local development configuration (bun run index.ts, no Docker).
# Copy this file to .env and edit with your values.
PORT=8921
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=Test-Safe-2026-Password
JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars

# JetAPI scraper service (run separately, see project docs)
JETAPI_URL=http://localhost:8922

# Set to false to allow new users to sign up
DISABLE_REGISTRATION=true
