# Port where the frontend will be accessible
FRONTEND_PORT=8920

# Superuser account (created on first run) — change these!
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=SecurePassword123!

# JWT secret for token signing (minimum 32 characters, change this!)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_secret_jwt_key_here_change_this_to_random_32_chars_min

# Public URL of the frontend
FRONTEND_URL=http://localhost

# Set to false to allow new users to sign up
DISABLE_REGISTRATION=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@example.com
