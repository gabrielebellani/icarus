# Icarus Docker Self-Hosting Configuration
# Copy this file to .env and edit with your values

# ========== Frontend ==========
# Port where the frontend will be accessible (default: 80)
FRONTEND_PORT=80

# ========== Backend / Authentication ==========
# Backend API server port (internal, not published to host)
# Usually port 3465
# PORT=3465

# Superuser account (created on first run)
# Change these to secure values!
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=SecurePassword123!

# JWT secret for token signing (minimum 32 characters, change this!)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_secret_jwt_key_here_change_this_to_random_32_chars_min

# ========== Database & Cache ==========
# Redis cache (default: redis://redis-cache:6379)
# REDIS_URL=redis://redis-cache:6379

# Optional: custom database path inside container (default: /app/data/icarus-db.sqlite)
# DB_PATH=/app/data/icarus-db.sqlite

# ========== External Services ==========
# JetAPI scraper service (public flight data aggregation)
# JETAPI_URL=http://jetapi-scraper:8922

# ========== Email / Password Recovery (Optional) ==========
# Leave empty to disable password recovery feature
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@icarus.example.com

# Frontend URL for password recovery links
# Set this to the URL users will access (used in password reset emails)
FRONTEND_URL=http://localhost
